{
  "appId": "daylight.usermanager.v4",
  "name": "User Manager",
  "version": "4.0.0",
  "manifestVersion": "1",
  "semanticType": "schema:SoftwareApplication",
  "healthEndpoint": "http://host.docker.internal:5000/api/health",
  "healthIntervalSeconds": 30,
  "baseUrl": "http://localhost:5000",
  "domain": "usermanager",

  "entities": [
    {
      "name": "User",
      "baseType": "schema:Person",
      "searchable": true,
      "spaceElement": "usermanager.user.card",
      "produces": ["User"],
      "consumes": [],
      "schema": {
        "id": "string",
        "name": "string",
        "email": "string",
        "roleKey": "string"
      },
      "expectedFields": []
    },
    {
      "name": "Contact",
      "baseType": "schema:Person",
      "searchable": true,
      "spaceElement": "usermanager.contact.card",
      "produces": ["Contact"],
      "consumes": [],
      "schema": {
        "id": "string",
        "name": "string",
        "email": "string",
        "phone": "string",
        "company": "string"
      },
      "expectedFields": []
    },
    {
      "name": "Role",
      "baseType": "schema:Role",
      "searchable": false,
      "produces": ["Role"],
      "consumes": [],
      "schema": { "key": "string", "label": "string" },
      "expectedFields": []
    },
    {
      "name": "Permission",
      "baseType": "schema:Action",
      "searchable": false,
      "produces": ["Permission"],
      "consumes": [],
      "schema": { "key": "string", "label": "string", "category": "string" },
      "expectedFields": []
    }
  ],

  "intents": {
    "handles": ["VERIFY_IDENTITY", "LOG_AUDIT", "REQUEST_APPROVAL"],
    "emits": ["IDENTIFY_EMPLOYEE", "SEND_NOTIFICATION"]
  },

  "events": {
    "publishes": [
      "com.daylight.usermanager.user.created",
      "com.daylight.usermanager.user.updated",
      "com.daylight.usermanager.user.deleted",
      "com.daylight.usermanager.contact.created",
      "com.daylight.usermanager.contact.updated",
      "com.daylight.usermanager.contact.deleted",
      "com.daylight.usermanager.role.assigned",
      "com.daylight.usermanager.role.updated",
      "com.daylight.usermanager.permission.granted",
      "com.daylight.usermanager.permission.revoked"
    ],
    "subscribes": [
      "com.daylight.messaging.notification.delivered"
    ]
  },

  "actions": [
    {
      "id": "usermanager-verify-identity",
      "endpoint": "/api/users/verify",
      "agentReady": true,
      "agentDescription": "Verify the identity of a user by checking their credentials and returning their profile with assigned roles",
      "intent": "VERIFY_IDENTITY",
      "triggers": [],
      "parameters": [
        { "name": "userId", "type": "string", "description": "Unique identifier of the user to verify", "required": true  },
        { "name": "email",  "type": "string", "description": "Email address of the user to verify",    "required": false }
      ]
    },
    {
      "id": "usermanager-log-audit",
      "endpoint": "/api/audit",
      "agentReady": false,
      "agentDescription": "Log an audit event for a user action",
      "intent": "LOG_AUDIT",
      "triggers": [],
      "parameters": [
        { "name": "userId", "type": "string", "description": "ID of the user who performed the action", "required": true },
        { "name": "action", "type": "string", "description": "Description of the action performed",     "required": true }
      ]
    },
    {
      "id": "usermanager-request-approval",
      "endpoint": "/api/approvals",
      "agentReady": true,
      "agentDescription": "Submit an approval request when a user requires a role change or elevated access that needs administrator review",
      "intent": "REQUEST_APPROVAL",
      "triggers": [],
      "parameters": [
        { "name": "userId",        "type": "string", "description": "ID of the user requesting the role change",          "required": true  },
        { "name": "requestedRole", "type": "string", "description": "Role key being requested: viewer, editor, or admin", "required": true  },
        { "name": "reason",        "type": "string", "description": "Business reason for the access request",             "required": false }
      ]
    }
  ],

  "space": {
    "workflowContexts": ["usermanager.user", "usermanager.role", "usermanager.contact"],
    "widgets": [
      {
        "entityType":  "User",
        "componentId": "usermanager-user-card",
        "bundleUrl":   "/widgets/user-card.js",
        "displayMode": "compact"
      },
      {
        "entityType":  "Contact",
        "componentId": "usermanager-contact-card",
        "bundleUrl":   "/widgets/contact-card.js",
        "displayMode": "compact"
      }
    ]
  },

  "permissions": [
    { "key": "users:manage",      "label": "Manage Users",       "category": "Users"        },
    { "key": "contacts:read",     "label": "Read Contacts",      "category": "Contacts"     },
    { "key": "contacts:write",    "label": "Write Contacts",     "category": "Contacts"     },
    { "key": "contacts:delete",   "label": "Delete Contacts",    "category": "Contacts"     },
    { "key": "deals:read",        "label": "Read Deals",         "category": "Deals"        },
    { "key": "deals:write",       "label": "Write Deals",        "category": "Deals"        },
    { "key": "deals:delete",      "label": "Delete Deals",       "category": "Deals"        },
    { "key": "accounts:read",     "label": "Read Accounts",      "category": "Accounts"     },
    { "key": "accounts:write",    "label": "Write Accounts",     "category": "Accounts"     },
    { "key": "reports:view",      "label": "View Reports",       "category": "Reports"      },
    { "key": "roles:read",        "label": "View Roles",         "category": "Administration" },
    { "key": "roles:manage",      "label": "Manage Roles",       "category": "Administration" },
    { "key": "audit:read",        "label": "View Audit Logs",    "category": "Compliance"   }
  ],

  "roles": [
    {
      "key": "viewer",
      "label": "Viewer",
      "description": "Read-only access to contacts, deals, accounts, and reports",
      "defaultPermissions": [
        "contacts:read",
        "deals:read",
        "accounts:read",
        "reports:view"
      ]
    },
    {
      "key": "editor",
      "label": "Editor",
      "description": "Read and write access to contacts, deals, and accounts",
      "defaultPermissions": [
        "contacts:read",
        "contacts:write",
        "deals:read",
        "deals:write",
        "accounts:read",
        "accounts:write",
        "reports:view"
      ]
    },
    {
      "key": "admin",
      "label": "Admin",
      "description": "Full access including user management, role management, and all data operations",
      "defaultPermissions": [
        "users:manage",
        "contacts:read",
        "contacts:write",
        "contacts:delete",
        "deals:read",
        "deals:write",
        "deals:delete",
        "accounts:read",
        "accounts:write",
        "reports:view",
        "roles:read",
        "roles:manage",
        "audit:read"
      ]
    }
  ],

  "defaultRole": "viewer"
}
