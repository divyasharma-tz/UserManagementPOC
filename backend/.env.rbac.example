# RBAC External Sync Configuration
# Add these lines to your backend/.env file

# RBAC Role Mapping API (GET roles list)
RBAC_ROLES_API_URL=http://localhost:5006/api/v1/auth

# RBAC User Role Update API (PUT user role)
RBAC_UPDATE_API_URL=http://localhost:5007/api/v1/auth

# Application name for RBAC endpoints
RBAC_APP_NAME=usermanager
